#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    macros {
        new_macro: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EXCL &kp LS(Q) &kp LS(A) &kp LS(Z) &kp X &kp S &kp W &kp N2 &kp N7 &kp ENTER>;
            label = "NEW_MACRO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "Base";
            bindings = <
&kp TAB         &kp Q  &kp W  &kp E     &kp R  &kp T        &kp Y    &kp U  &kp I          &kp O    &kp P     &kp LEFT_BRACKET
&kp LEFT_SHIFT  &kp A  &kp S  &kp D     &kp F  &kp G        &kp H    &kp J  &kp K          &kp L    &kp SEMI  &kp RIGHT_BRACKET
&kp LCTRL       &kp Z  &kp X  &kp C     &kp V  &kp B        &kp N    &kp M  &kp COMMA      &kp DOT  &kp FSLH  &kp SQT
                              &kp LGUI  &mo 1  &kp SPACE    &kp RET  &mo 2  &kp BACKSPACE
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Lower";
            bindings = <
&bt BT_CLR_ALL    &bt BT_SEL 0  &kp PAGE_UP     &kp UP_ARROW    &kp HOME         &kp LC(P)            &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_0  &kp PLUS   &kp BACKSLASH
&kp LEFT_SHIFT    &bt BT_SEL 1  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp LC(A)            &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp MINUS     &kp LC(Z)  &kp LC(X)
&kp LEFT_CONTROL  &bt BT_SEL 2  &kp PAGE_DOWN   &kp CAPSLOCK    &kp END          &kp LC(S)            &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp EQUAL     &kp LC(C)  &kp LC(V)
                                                &mo 3           &trans           &kp LS(LC(SPACE))    &kp RET       &trans        &kp DELETE
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Raise";
            bindings = <
&kp TAB    &kp F1   &kp F2   &kp F3  &kp F4  &kp F5       &kp EXCLAMATION  &kp AT_SIGN   &kp HASH              &kp RIGHT_PARENTHESIS  &none  &none
&kp LCTRL  &kp F6   &kp F7   &kp F8  &kp F9  &kp F10      &kp DOLLAR       &kp PERCENT   &kp CARET             &none                  &none  &none
&kp LSHFT  &kp F11  &kp F12  &none   &none   &none        &kp AMPERSAND    &kp ASTERISK  &kp LEFT_PARENTHESIS  &none                  &none  &none
                             &trans  &trans  &kp SPACE    &kp RET          &trans        &kp RALT
            >;
        };

        extra_1 {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "ext1";
            bindings = <
&bt BT_CLR_ALL  &bt BT_SEL 0  &kp F2   &kp F3      &kp F4     &kp C_VOL_UP    &kp C_BRI_UP  &kp AT_SIGN   &kp HASH              &kp RIGHT_PARENTHESIS  &none  &none
&kp LCTRL       &bt BT_SEL 1  &kp F7   &kp F8      &kp F9     &kp C_VOL_DN    &kp C_BRI_DN  &kp PERCENT   &kp CARET             &none                  &none  &none
&kp LSHFT       &bt BT_SEL 2  &kp F12  &new_macro  &kp LG(L)  &kp C_MUTE      &kp LG(L)     &kp ASTERISK  &kp LEFT_PARENTHESIS  &none                  &none  &none
                                       &trans      &trans     &kp SPACE       &kp RET       &trans        &kp RALT
            >;
        };

        extra_2 {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "ext2";
            bindings = <
&kp TAB    &kp F1   &kp F2   &kp F3    &kp F4  &kp F5       &kp EXCLAMATION  &kp AT_SIGN   &kp HASH              &kp RIGHT_PARENTHESIS  &none  &none
&kp LCTRL  &kp F6   &kp F7   &kp F8    &kp F9  &kp F10      &kp DOLLAR       &kp PERCENT   &kp CARET             &none                  &none  &none
&kp LSHFT  &kp F11  &kp F12  &none     &none   &none        &kp AMPERSAND    &kp ASTERISK  &kp LEFT_PARENTHESIS  &none                  &none  &none
                             &kp LGUI  &trans  &kp SPACE    &kp RET          &trans        &kp RALT
            >;
        };

        extra_3 { status = "reserved"; };
    };
};
