#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    macros {
        new_macro: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LEFT_CONTROL) &kp EXCL &kp LS(Q) &kp LS(A) &kp LS(Z) &kp X &kp S &kp W &kp N2 &kp N7 &kp ENTER>;
            label = "NEW_MACRO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "Base";
            bindings = <
&kp TAB         &kp Q  &kp W  &kp E     &kp R  &kp T        &kp Y    &kp U  &kp I          &kp O    &kp P     &kp LEFT_BRACKET
&kp LEFT_SHIFT  &kp A  &kp S  &kp D     &kp F  &kp G        &kp H    &kp J  &kp K          &kp L    &kp SEMI  &kp RIGHT_BRACKET
&kp LCTRL       &kp Z  &kp X  &kp C     &kp V  &kp B        &kp N    &kp M  &kp COMMA      &kp DOT  &kp FSLH  &kp SQT
                              &kp LGUI  &mo 1  &kp SPACE    &kp RET  &mo 2  &kp BACKSPACE
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Lower";
            bindings = <
&kp TAB           &kp GRAVE             &kp PAGE_UP     &kp UP_ARROW    &kp HOME         &kp LC(HOME)         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_0  &kp PLUS       &kp NON_US_BACKSLASH
&kp LEFT_SHIFT    &kp NON_US_BACKSLASH  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp LC(DELETE)       &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp MINUS     &kp COMMA      &kp DOT
&kp LEFT_CONTROL  &kp LS(LEFT_ALT)      &kp PAGE_DOWN   &kp CAPSLOCK    &kp END          &kp LC(END)          &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp EQUAL     &kp BACKSLASH  &kp SLASH
                                                        &mo 3           &trans           &kp LS(LC(SPACE))    &kp RET       &trans        &kp DELETE
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Raise";
            bindings = <
&kp LG(L)  &kp LG(LS(S))  &kp RS(RA(D))  &kp LC(L)  &kp LC(E)  &kp LC(R)    &kp EXCLAMATION  &kp AT_SIGN   &kp HASH              &kp RIGHT_PARENTHESIS  &kp LEFT_BRACE  &kp RIGHT_BRACE
&kp TAB    &kp LC(A)      &kp LC(S)      &kp LC(P)  &kp LC(N)  &kp LC(J)    &kp DOLLAR       &kp PERCENT   &kp CARET             &kp PLUS               &kp LESS_THAN   &kp GREATER_THAN
&kp LSHFT  &kp LC(Z)      &kp LC(X)      &kp LC(C)  &kp LC(V)  &kp LC(H)    &kp AMPERSAND    &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp KP_EQUAL           &kp BACKSLASH   &kp SLASH
                                         &trans     &trans     &kp SPACE    &kp RET          &trans        &kp RALT
            >;
        };

        extra_1 {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "ext1";
            bindings = <
&bt BT_CLR_ALL  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &kp C_VOL_UP    &kp C_BRI_UP  &none   &none              &none  &none  &none
&none           &none         &none         &none         &none         &kp C_VOL_DN    &kp C_BRI_DN  &none   &none              &none  &none  &none
&none           &none         &none         &new_macro    &kp LG(L)     &kp C_MUTE      &none         &none   &none              &none  &none  &none
                                            &trans        &trans        &kp SPACE       &kp RET       &trans  &kp LC(BACKSPACE)
            >;
        };
    };
};
